# Public base URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://iupk.org

# Contact form delivery via Resend (https://resend.com). Leave empty to disable sending;
# visitors will then be asked to email info@iupk.org directly.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=info@iupk.org
# Verified sender address on your Resend domain, e.g. "IoU Website <website@iupk.org>".
CONTACT_FROM_EMAIL=
